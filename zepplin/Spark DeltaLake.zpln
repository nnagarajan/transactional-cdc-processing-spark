    {
      "text": "%spark.conf\n\n# It is strongly recommended to set SPARK_HOME explicitly instead of using the embedded%sspark of Zeppelin. As the function of embedded spark of Zeppelin is limited and can only run in local mode.\nSPARK_HOME /opt/spark/spark-4.0.2\n\n#spark.driver.extraJavaOptions -Dhttp.proxyHost\u003d\u003c\u003e -Dhttp.proxyPort\u003d\u003c\u003e -Dhttps.proxyHost\u003d\u003c\u003e -Dhttps.proxyPort\u003d\u003c\u003e\n#To use spark 3.3.x you should disable zeppelin.spark.enableSupportedVersionCheck\u003dfalse in interpreter menu\n\nspark.jars.packages io.delta:delta-spark_2.13:4.0.1,org.apache.spark:spark-sql-kafka-0-10_2.13:4.0.1\nspark.sql.extensions io.delta.sql.DeltaSparkSessionExtension\nspark.sql.catalog.spark_catalog org.apache.spark.sql.delta.catalog.DeltaCatalog\nspark.sql.warehouse.dir file:/tmp/warehouse/sql2\nspark.sql.catalogImplementation hive\nspark.executor.memory 12G\nspark.driver.memory 12G\nspark.driver.cores 4\nspark.hadoop.javax.jdo.option.ConnectionURL jdbc:derby:/tmp/warehouse/metastore_db1;create\u003dtrue\nspark.hadoop.javax.jdo.option.ConnectionDriverName org.apache.derby.jdbc.EmbeddedDriver",
